# ==============================================================================
# FEAS 2.0 - Firebase Cloud Configuration (Spark Plan - 100% Free)
# ==============================================================================
# If these variables are not set, FEAS 2.0 operates in High-Fidelity
# Local Air-Gapped / Mock Mode without failing or requiring cloud connectivity.

# ------------------------------------------------------------------------------
# 1. Python Backend & Workstation (firebase-admin)
# ------------------------------------------------------------------------------
# Download from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_CREDENTIALS="firebase-service-account.json"
FIREBASE_PROJECT_ID="feas-forensics-dev"
FIREBASE_STORAGE_BUCKET="feas-forensics-dev.appspot.com"

# ------------------------------------------------------------------------------
# 2. React 3D Lab Dashboard (Vite Frontend)
# ------------------------------------------------------------------------------
# Find in Firebase Console -> Project Settings -> General -> Your Apps -> Web
VITE_FIREBASE_API_KEY="AIzaSyDEMO-KEY-FEAS-FORENSICS"
VITE_FIREBASE_AUTH_DOMAIN="feas-forensics-dev.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="feas-forensics-dev"
VITE_FIREBASE_STORAGE_BUCKET="feas-forensics-dev.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# ------------------------------------------------------------------------------
# 3. Firebase Local Emulator Suite (Optional 100% Offline Testing)
# ------------------------------------------------------------------------------
# FIREBASE_USE_EMULATOR=false
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
# STORAGE_EMULATOR_HOST="127.0.0.1:9199"
