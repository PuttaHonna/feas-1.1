# ====================================================================
# FEAS 2.0 - Environment Variables & Cloud Integrations
# ====================================================================

# Cloudflare R2 Zero-Egress Storage (10 GB Free Tier)
# Get these in Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=feas-videos
# Optional: Set if you enabled public access or custom domain on your bucket
R2_PUBLIC_URL=
# Automatically clean bulky raw videos from local disk after uploading to R2
R2_AUTO_CLEAN_LOCAL=true

# Server & Runtime Configuration
PORT=10000
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
TORCH_NUM_THREADS=1
PYTHONUNBUFFERED=1
